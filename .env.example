# --- X (Twitter) API credentials ---
# From https://developer.x.com -> your app -> Keys and tokens
X_API_KEY=
X_API_KEY_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# Optional: bearer token for read endpoints
X_BEARER_TOKEN=

# --- Supabase ---
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (Phase 2 draft generation) ---
ANTHROPIC_API_KEY=

# --- Pipeline controls ---
# When true, /api/test-publish and the publisher worker simulate calls
# without hitting X (no money spent). Flip to false when you're ready
# to send real posts.
DRY_RUN=true

# Hard daily spend cap in USD. The publisher pauses when crossed.
DAILY_BUDGET_USD=2.00

# Shared secret for Vercel cron requests. Set the same value in
# Vercel project env vars, and the cron handler checks it.
CRON_SECRET=
